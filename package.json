{
  "name": "lay-transcript",
  "productName": "Lấy Transcript",
  "version": "1.0.0",
  "description": "Lấy transcript chuẩn từ YouTube bằng Whisper — tự động tải, tự động nhận dạng giọng nói, không cần chạy lệnh.",
  "author": {
    "name": "holuc2702",
    "email": "holuc1991@gmail.com"
  },
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test 'test/**/*.test.js'",
    "test:sidecar": "node --test test/sidecar.test.js",
    "fetch-deps": "bash scripts/fetch-deps.sh",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "build:mac": "bash scripts/build-mac.sh",
    "e2e": "node scripts/e2e-ui.mjs",
    "e2e:autostart": "node scripts/e2e-autostart.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holuc2702/lay-transcript.git"
  },
  "homepage": "https://github.com/holuc2702/lay-transcript",
  "build": {
    "appId": "vn.laytranscript.app",
    "productName": "Lấy Transcript",
    "copyright": "Lấy Transcript",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "!**/.DS_Store"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Lấy Transcript ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lấy Transcript",
      "artifactName": "Lay-Transcript-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "holuc2702",
        "repo": "lay-transcript"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}